# Copy to apps/web/.env.local and apps/worker/.env

# Demo fixtures are off by default. Set true only for local development.
NEXT_PUBLIC_DEMO_MODE=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy variable name accepted by the unused Supabase client helpers.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (Single key or comma-separated multiple keys for automatic round-robin rotation)
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.8-flash

# Gmail OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
GOOGLE_ALLOWED_EMAIL=your-dedicated-inbox@gmail.com

# Private app access
APP_PASSWORD=
APP_SESSION_SECRET=

# OAuth token encryption (32-byte key, hex or base64)
TOKEN_ENCRYPTION_KEY=

# Application
APP_URL=http://localhost:3000
CRON_SECRET=
SYNC_INTERVAL_MINUTES=10
NEWSLETTER_LABEL=INBOX

# Optional operational settings
LOG_LEVEL=info
MAX_EMAILS_PER_SYNC=50
MAX_AI_RETRIES=3
MAX_BACKFILL=100
